FROM surrealdb/surrealdb:v3 AS surreal
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libstdc++6 libgcc-s1 && rm -rf /var/lib/apt/lists/*

COPY --from=surreal /surreal /usr/local/bin/surreal
COPY scripts/surrealdb-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh /usr/local/bin/surreal

ENTRYPOINT ["/entrypoint.sh"]
