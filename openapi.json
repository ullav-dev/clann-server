{
    "components": {
        "schemas": {
            "AddRelationshipRequest": {
                "properties": {
                    "related_id": {
                        "description": "Full record ID of the related person, e.g. `person:01jd4a8xyz`.",
                        "type": "string"
                    },
                    "sibling_type": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "$ref": "#/components/schemas/SiblingType",
                                "description": "Required when `type` is `Sibling`."
                            }
                        ]
                    },
                    "spouse_from": {
                        "description": "Optional marriage/partnership start date (ISO 8601 or free-form string).",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "spouse_to": {
                        "description": "Optional marriage/partnership end date.",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "type": {
                        "$ref": "#/components/schemas/RelationshipType"
                    }
                },
                "required": [
                    "type",
                    "related_id"
                ],
                "type": "object"
            },
            "CreateFamilyTree": {
                "properties": {
                    "display_name": {
                        "description": "Human-readable display name.",
                        "type": "string"
                    },
                    "is_primary": {
                        "description": "Set to `true` to make this the owner's primary tree (clears `is_primary` on all others).",
                        "type": "boolean"
                    },
                    "name": {
                        "description": "Unique slug identifier for this tree (e.g. `\"smith-family\"`). Must be globally unique.",
                        "type": "string"
                    },
                    "owner": {
                        "description": "Username of the tree owner.",
                        "type": "string"
                    }
                },
                "required": [
                    "name",
                    "display_name",
                    "owner"
                ],
                "type": "object"
            },
            "CreatePerson": {
                "properties": {
                    "biography": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "created_by": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "date_of_birth": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "date_of_death": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "family_name": {
                        "type": "string"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "middle_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "nickname": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "place_of_birth": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "place_of_death": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "sex": {
                        "$ref": "#/components/schemas/Sex"
                    },
                    "tree": {
                        "description": "Name of the family tree this person belongs to. Must refer to an existing tree.",
                        "type": "string"
                    },
                    "username": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "family_name",
                    "first_name",
                    "sex",
                    "tree"
                ],
                "type": "object"
            },
            "ErrorResponse": {
                "description": "Error response body returned for all 4xx/5xx responses.",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "required": [
                    "error"
                ],
                "type": "object"
            },
            "FamilyTree": {
                "properties": {
                    "display_name": {
                        "description": "Human-readable display name.",
                        "type": "string"
                    },
                    "id": {
                        "description": "Record ID in the form `family_tree:<ulid>`.",
                        "example": "family_tree:01jd4a8xyz",
                        "type": "string"
                    },
                    "is_primary": {
                        "description": "Whether this is the owner's primary tree.",
                        "type": "boolean"
                    },
                    "name": {
                        "description": "Unique slug identifier for this tree (e.g. `\"smith-family\"`). Globally unique.",
                        "type": "string"
                    },
                    "owner": {
                        "description": "Username of the tree owner.",
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "display_name",
                    "owner"
                ],
                "type": "object"
            },
            "Person": {
                "properties": {
                    "biography": {
                        "description": "Short biography, up to 1000 characters.",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "created_by": {
                        "description": "Identifier of the user who created this record.",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "date_of_birth": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "date_of_death": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "family_name": {
                        "type": "string"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "id": {
                        "description": "Record ID in the form `person:<ulid>`.",
                        "example": "person:01jd4a8xyz",
                        "type": "string"
                    },
                    "image_path": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "middle_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "nickname": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "place_of_birth": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "place_of_death": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "sex": {
                        "$ref": "#/components/schemas/Sex"
                    },
                    "tree": {
                        "description": "Name of the family tree this person belongs to.",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "username": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "verified": {
                        "description": "Whether this person's identity has been verified. Defaults to `false`.",
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "family_name",
                    "first_name",
                    "sex"
                ],
                "type": "object"
            },
            "RelationshipType": {
                "enum": [
                    "Father",
                    "Mother",
                    "Sibling",
                    "Spouse"
                ],
                "type": "string"
            },
            "RelationshipsResponse": {
                "properties": {
                    "father": {
                        "items": {
                            "$ref": "#/components/schemas/Person"
                        },
                        "type": "array"
                    },
                    "mother": {
                        "items": {
                            "$ref": "#/components/schemas/Person"
                        },
                        "type": "array"
                    },
                    "siblings": {
                        "items": {
                            "$ref": "#/components/schemas/Person"
                        },
                        "type": "array"
                    },
                    "spouse": {
                        "items": {
                            "$ref": "#/components/schemas/SpouseInfo"
                        },
                        "type": "array"
                    }
                },
                "required": [
                    "father",
                    "mother",
                    "siblings",
                    "spouse"
                ],
                "type": "object"
            },
            "Sex": {
                "enum": [
                    "Male",
                    "Female"
                ],
                "type": "string"
            },
            "SiblingType": {
                "enum": [
                    "Brother",
                    "Sister"
                ],
                "type": "string"
            },
            "SpouseInfo": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Person"
                    },
                    {
                        "properties": {
                            "spouse_from": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "spouse_to": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        },
                        "type": "object"
                    }
                ],
                "description": "A spouse with the edge's date attributes included."
            },
            "UpdatePerson": {
                "description": "All fields are optional; only supplied fields are updated (MERGE semantics).",
                "properties": {
                    "biography": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "created_by": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "date_of_birth": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "date_of_death": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "family_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "first_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "middle_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "nickname": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "place_of_birth": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "place_of_death": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "sex": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "$ref": "#/components/schemas/Sex"
                            }
                        ]
                    },
                    "username": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "verified": {
                        "type": [
                            "boolean",
                            "null"
                        ]
                    }
                },
                "type": "object"
            },
            "UpdateSpouseDatesRequest": {
                "description": "Payload for updating spouse date attributes on an existing relationship.",
                "properties": {
                    "spouse_from": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "spouse_to": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "type": "object"
            }
        }
    },
    "info": {
        "description": "REST API for ancestry and family tree data management, backed by SurrealDB.",
        "license": {
            "name": ""
        },
        "title": "clann-server API",
        "version": "0.1.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/api/persons": {
            "get": {
                "operationId": "list_persons",
                "parameters": [
                    {
                        "description": "When present, only return/allow access to persons with this `created_by` value.",
                        "in": "query",
                        "name": "created_by",
                        "required": false,
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    },
                    {
                        "description": "When present, only return persons belonging to this family tree.",
                        "in": "query",
                        "name": "tree",
                        "required": false,
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/Person"
                                    },
                                    "type": "array"
                                }
                            }
                        },
                        "description": "List of persons, optionally filtered"
                    }
                },
                "tags": [
                    "persons"
                ]
            },
            "post": {
                "operationId": "create_person",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreatePerson"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Person"
                                }
                            }
                        },
                        "description": "Person created"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Bad request"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Invalid request body"
                    }
                },
                "tags": [
                    "persons"
                ]
            }
        },
        "/api/persons/{id}": {
            "delete": {
                "operationId": "delete_person",
                "parameters": [
                    {
                        "description": "Person record ID (without the `person:` prefix)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Person deleted"
                    }
                },
                "tags": [
                    "persons"
                ]
            },
            "get": {
                "operationId": "get_person",
                "parameters": [
                    {
                        "description": "Person record ID (without the `person:` prefix)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Person"
                                }
                            }
                        },
                        "description": "Person found"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Person not found"
                    }
                },
                "tags": [
                    "persons"
                ]
            },
            "put": {
                "operationId": "update_person",
                "parameters": [
                    {
                        "description": "Person record ID (without the `person:` prefix)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdatePerson"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Person"
                                }
                            }
                        },
                        "description": "Person updated"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Person not found"
                    }
                },
                "tags": [
                    "persons"
                ]
            }
        },
        "/api/persons/{id}/family-tree": {
            "get": {
                "operationId": "get_family_tree",
                "parameters": [
                    {
                        "description": "Person record ID (without the `person:` prefix)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Family tree up to 2 generations deep. Each node: `{ id, family_name, first_name, father: [node\u2026], mother: [node\u2026], children: [node\u2026], spouse: [node\u2026] }`"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Person not found"
                    }
                },
                "tags": [
                    "relationships"
                ]
            }
        },
        "/api/persons/{id}/image": {
            "get": {
                "operationId": "get_image",
                "parameters": [
                    {
                        "description": "Person record ID (without the `person:` prefix)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "image/jpeg": {}
                        },
                        "description": "Image file (JPEG or PNG)"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Person not found or no image uploaded"
                    }
                },
                "tags": [
                    "persons"
                ]
            },
            "post": {
                "operationId": "upload_image",
                "parameters": [
                    {
                        "description": "Person record ID (without the `person:` prefix)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "string"
                            }
                        }
                    },
                    "description": "Image file field named `image`. Accepts JPG or PNG, maximum 2 MB.",
                    "required": true
                },
                "responses": {
                    "204": {
                        "description": "Image uploaded and associated with the person"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Invalid file type, size exceeded, or missing field"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Person not found"
                    }
                },
                "tags": [
                    "persons"
                ]
            }
        },
        "/api/persons/{id}/relationships": {
            "get": {
                "operationId": "get_relationships",
                "parameters": [
                    {
                        "description": "Person record ID (without the `person:` prefix)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RelationshipsResponse"
                                }
                            }
                        },
                        "description": "Grouped relationships"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Person not found"
                    }
                },
                "tags": [
                    "relationships"
                ]
            },
            "post": {
                "operationId": "add_relationship",
                "parameters": [
                    {
                        "description": "Person record ID (without the `person:` prefix)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AddRelationshipRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Relationship added"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Bad request \u2014 e.g. missing sibling_type"
                    }
                },
                "tags": [
                    "relationships"
                ]
            }
        },
        "/api/persons/{id}/relationships/{rel_type}/{related_id}": {
            "delete": {
                "operationId": "delete_relationship",
                "parameters": [
                    {
                        "description": "Person record ID (without the `person:` prefix)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Relationship table: `has_father`, `has_mother`, `has_sibling`, or `has_spouse`",
                        "in": "path",
                        "name": "rel_type",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Full related record ID, e.g. `person:01jd4a8xyz`",
                        "in": "path",
                        "name": "related_id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Relationship deleted"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Invalid relationship type"
                    }
                },
                "tags": [
                    "relationships"
                ]
            }
        },
        "/api/persons/{id}/spouse-dates/{related_id}": {
            "patch": {
                "operationId": "update_spouse_dates",
                "parameters": [
                    {
                        "description": "Person record ID (without the `person:` prefix)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Full related record ID, e.g. `person:01jd4a8xyz`",
                        "in": "path",
                        "name": "related_id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateSpouseDatesRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "204": {
                        "description": "Spouse dates updated"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        },
                        "description": "Bad request"
                    }
                },
                "tags": [
                    "relationships"
                ]
            }
        },
        "/api/trees": {
            "get": {
                "operationId": "list_trees",
                "parameters": [
                    {
                        "description": "When present, only return trees with this owner.",
                        "in": "query",
                        "name": "owner",
                        "required": false,
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/FamilyTree"
                                    },
                                    "type": "array"
                                }
                            }
                        },
                        "description": "List of family trees"
                    }
                },
                "tags": [
                    "trees"
                ]
            },
            "post": {
                "operationId": "create_tree",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateFamilyTree"
                            }
                        }
                    },
                    "required": true
                },
